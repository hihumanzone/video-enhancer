{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 3008,
      "maxDuration": 60,
      "includeFiles": "node_modules/ffmpeg-static/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/outputs/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
